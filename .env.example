# Bo'sh qoldirilsa, lokal PGlite (.data/pglite) ishlatiladi
DATABASE_URL=

# Sayt manzili (sitemap, OG, UTM uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shu raqamlar kirganda admin roli beriladi (vergul bilan)
ADMIN_PHONES=+998900000000

# SMS: bo'sh bo'lsa kod server konsoliga chiqadi (faqat dev)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Faqat sinov serverida: SMS o'rniga kodni logga yozish
SMS_DEV_LOG=

# Telegram bot: kirish, bildirishnomalar, Mini App (README → Telegram bot)
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: bo'lmasa getMe orqali aniqlanadi
TELEGRAM_BOT_USERNAME=

# Cron endpointlarini himoyalash
CRON_SECRET=

# Yuklash limitlari (bepul hostingda qattiq, keyin bo'shatiladi)
MAX_IMAGES=10
MAX_SCREENSHOTS=6
# 0 = video yuklash o'chirilgan, faqat YouTube/Instagram havolasi
MAX_VIDEOS=3
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=60
# Admin dashboarddagi xotira hisoblagichi uchun
STORAGE_LIMIT_MB=1024

# --- Faqat VPS (docker compose) ---
DOMAIN=xorazmmedia.uz
POSTGRES_PASSWORD=
